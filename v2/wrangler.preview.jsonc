{
  "name": "personal-workbench-v2-preview",
  "main": "staging-worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./preview-public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/sync",
      "/sync/*"
    ]
  },
  "vars": {
    "TEST_ENVIRONMENT": "synthetic-only",
    "TEST_DATASET": "mobile-preview-20261111"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_SYNC",
        "class_name": "TestSync"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2-preview-sqlite-1",
      "new_sqlite_classes": [
        "TestSync"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
